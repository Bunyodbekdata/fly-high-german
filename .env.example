# ====================================================================
# FOR GREAT NATION - German Learning Platform Environment Variables
# ====================================================================

# 1. Supabase Cloud Configuration (Optional: Local offline demo mode works automatically)
# Get these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Administrator Account Email
# Bu email platforma interfeysida 'admin' rolini oladi. Haqiqiy huquq
# ma'lumotlar bazasida beriladi (klientdan rol yozib bo'lmaydi):
#   UPDATE public.profiles SET role = 'admin' WHERE email = '...';
VITE_ADMIN_EMAIL=admin@greatnation.uz

# 3. Mahalliy (offline) demo autentifikatsiyasi
# Production buildda O'CHIQ. Faqat backend'siz demo/taqdimot uchun 'true' qiling.
# Bu rejimda parollar brauzerda tuzli SHA-256 ko'rinishida saqlanadi.
VITE_ENABLE_LOCAL_AUTH=false
