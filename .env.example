# ====================================================================
# FOR GREAT NATION - German Learning Platform Environment Variables
# ====================================================================

# 1. Supabase Cloud Configuration (Optional: Local offline demo mode works automatically)
# Get these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Administrator Account Email
# This email automatically receives the 'admin' role in the platform
VITE_ADMIN_EMAIL=admin@greatnation.uz
